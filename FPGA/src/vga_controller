module vga_controller (
    input  wire       clk,        // Pixel clock (Ideally 25.175 MHz for 640x480)
    input  wire       rst,
    output reg        hsync,      // Horizontal Sync Pulse
    output reg        vsync,      // Vertical Sync Pulse
    output wire [9:0] x_coord,    // Current X position (0 to 639)
    output wire [9:0] y_coord,    // Current Y position (0 to 479)
    output wire       active_vid  // HIGH when we are in the visible screen area
);

    // 640x480 VGA Timing Standards
    localparam H_DISPLAY = 640;
    localparam H_FRONT   = 16;
    localparam H_SYNC    = 96;
    localparam H_BACK    = 48;
    localparam H_TOTAL   = 800;

    localparam V_DISPLAY = 480;
    localparam V_FRONT   = 10;
    localparam V_SYNC    = 2;
    localparam V_BACK    = 33;
    localparam V_TOTAL   = 525;

    reg [9:0] h_counter;
    reg [9:0] v_counter;

    // The visible area
    assign active_vid = (h_counter < H_DISPLAY) && (v_counter < V_DISPLAY);
    
    // Export coordinates for the VRAM
    assign x_coord = (h_counter < H_DISPLAY) ? h_counter : 10'b0;
    assign y_coord = (v_counter < V_DISPLAY) ? v_counter : 10'b0;

    always @(posedge clk or posedge rst) begin
        if (rst) begin
            h_counter <= 0;
            v_counter <= 0;
            hsync <= 1'b1;
            vsync <= 1'b1;
        end else begin
            // Horizontal Counter
            if (h_counter == H_TOTAL - 1) begin
                h_counter <= 0;
                // Vertical Counter increments at the end of every line
                if (v_counter == V_TOTAL - 1) begin
                    v_counter <= 0;
                end else begin
                    v_counter <= v_counter + 1;
                end
            end else begin
                h_counter <= h_counter + 1;
            end

            // Generate Sync Pulses (Active Low for standard VGA)
            hsync <= ~( (h_counter >= H_DISPLAY + H_FRONT) && (h_counter < H_DISPLAY + H_FRONT + H_SYNC) );
            vsync <= ~( (v_counter >= V_DISPLAY + V_FRONT) && (v_counter < V_DISPLAY + V_FRONT + V_SYNC) );
        end
    end

endmodule